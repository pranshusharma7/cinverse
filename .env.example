# CINÉVERSE Vercel Production Environment Variables
# Copy these values into your Vercel Project Dashboard (Settings > Environment Variables)

# TMDb API Key (Required for live movie and TV show data)
TMDB_API_KEY=4e44d9029b1270a757cddc766a1bcb63

# Optional: TMDb v4 Read Access Token (Leave empty if using API Key)
TMDB_ACCESS_TOKEN=

# Streaming Provider Configuration
NXSHA_PLAYBACK_ENABLED=true
NXSHA_BASE_URL=https://nxsha.space/embed
NXSHA_THEME_COLOR=green

# Stream Fallback
ENABLE_STREAM_FALLBACK=true
